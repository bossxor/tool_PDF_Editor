{
  "name": "pdf-editor",
  "version": "0.1.4",
  "private": true,
  "description": "PDF viewer & editor",
  "license": "AGPL-3.0-or-later",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ui": "npm run build && electron scripts/ui-smoke.cjs",
    "test:engine": "npm run build && node scripts/engine-regression.mjs",
    "test:app": "electron scripts/app-smoke.cjs",
    "test:installer": "node scripts/installer-check.cjs",
    "icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 && node scripts/sync-distribution.cjs",
    "dist:installer": "electron-vite build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.pdfeditor",
    "productName": "PDF Editor",
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "PDF.Editor.Setup.${version}.exe",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Editor"
    },
    "portable": {
      "artifactName": "PDF.Editor.Portable.${version}.exe"
    }
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "mupdf": "^1.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
